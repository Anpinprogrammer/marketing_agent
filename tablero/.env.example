# Copia este archivo a tablero/.env y llénalo. El .env nunca se sube al repo.

# Llave de Anthropic Console (workspace del equipo, con límite de gasto).
ANTHROPIC_API_KEY=
# Modelo y esfuerzo de la guía. "low" basta para conversar sobre tareas.
TABLERO_MODELO=claude-haiku-5-5
TABLERO_ESFUERZO=low

# Token de GitHub con permiso de escritura SOLO en Anpinprogrammer/marketing_agent
# (fine-grained: Contents y Pull requests en lectura y escritura).
GITHUB_TOKEN=
TABLERO_GITHUB_REPO=Anpinprogrammer/marketing_agent
TABLERO_GITHUB_RAMA_BASE=main

# Contraseña de PostgreSQL (solo la usa docker compose).
POSTGRES_PASSWORD=

# Dirección con la que el equipo abre el tablero; se usa en los enlaces de acceso.
TABLERO_URL_PUBLICA=http://localhost:8000
TABLERO_MAX_MB=20
TABLERO_ZONA=America/Bogota

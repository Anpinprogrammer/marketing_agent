# Copiar a .env (no se sube al repositorio). Valores del gestor de contraseñas.

# Llave de Anthropic Console del espacio de trabajo "agente", con límite de gasto.
ANTHROPIC_API_KEY=

# Bot de PRUEBA creado con BotFather (nunca el de producción).
TELEGRAM_BOT_TOKEN=
# IDs numéricos separados por coma: Andrés y la especialista en mercadeo.
TELEGRAM_ALLOWED_USERS=
# Chat donde llegan las tareas programadas (caso T6); normalmente el ID de Andrés.
TELEGRAM_HOME_CHANNEL=
